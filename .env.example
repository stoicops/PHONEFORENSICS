# PhoneForensics reads these from the environment (it does not load .env files itself).
# Copy the lines you need into your shell profile or launcher. All are optional.

# Where checks and their results are saved. Default: ~/PhoneForensics
PHONEFORENSICS_HOME=

# Port for the local web interface (only ever bound to 127.0.0.1). Default: 8765
PHONEFORENSICS_PORT=

# https link for the "Buy me a coffee" button. Set to an empty value to hide it in a fork.
PHONEFORENSICS_SUPPORT_URL=

# DEBUG, INFO, WARNING or ERROR. Default: INFO
PHONEFORENSICS_LOG_LEVEL=
